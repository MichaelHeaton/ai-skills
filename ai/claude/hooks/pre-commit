#!/usr/bin/env bash
# Scans staged SKILL.md files for secrets and generic public-repo leak patterns.
# Employer-specific tokens (Jira project keys, internal Slack channels) belong in
# ~/.config/claude-skills/leak-patterns (private, never committed) — see config/leak-patterns.README.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

STAGED=$(git diff --cached --name-only | grep -E '(^|/)SKILL\.md$' || true)

if [[ -z "$STAGED" ]]; then
  exit 0
fi

declare -A PATTERNS
PATTERNS=(
  ["AWS access key"]='AKIA[0-9A-Z]{16}'
  ["AWS secret key"]='(?i)aws.{0,20}secret.{0,20}[=:][[:space:]]*[A-Za-z0-9/+=]{40}'
  ["GitHub token"]='(ghp|gho|ghu|ghs|ghr|github_pat)_[A-Za-z0-9_]{20,}'
  ["Stripe live key"]='sk_live_[0-9a-zA-Z]{24}'
  ["Stripe test key"]='sk_test_[0-9a-zA-Z]{24}'
  ["Private key block"]='-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY'
  ["Bearer token"]='(?i)bearer[[:space:]]+[A-Za-z0-9+/._-]{20,}'
  ["Generic API key assignment"]='(?i)(api[_-]?key|apikey)[[:space:]]*[:=][[:space:]]*["\x27][A-Za-z0-9+/._-]{16,}'
  ["Generic secret assignment"]='(?i)(secret|password|passwd|token)[[:space:]]*[:=][[:space:]]*["\x27][^"\x27\s]{8,}'
  ["Slack token"]='xox[baprs]-[A-Za-z0-9-]+'
  ["Heroku API key"]='(?i)heroku.{0,20}[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
)

declare -A PII_PATTERNS
PII_PATTERNS=(
  ["Email address"]='[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}'
  ["Absolute home path"]='/(?:Users|home)/[a-z][a-z0-9_-]+/'
  ["Hardcoded gh username (--user/--owner/--repo)"]='(?:--user|--owner)\s+[A-Za-z][A-Za-z0-9-]+|--repo\s+[A-Z][a-z][A-Za-z0-9-]*/'
)

# Generic only — no employer project keys or channel names in this repo
declare -A PUBLIC_LEAK_PATTERNS
PUBLIC_LEAK_PATTERNS=(
  ["Corp Jira host"]='jira\.corp\.[a-z0-9.-]+'
  ["SharePoint personal URL"]='sharepoint\.com.*/personal/'
  ["Likely real Jira key"]='[A-Z]{4,10}-[1-9][0-9]{3,}'
)

PRIVATE_LEAK_FILE="${HOME}/.config/claude-skills/leak-patterns"

SECRETS_FOUND=0
PII_FOUND=0

scan_pattern() {
  local label="$1"
  local pattern="$2"
  local file="$3"
  local content="$4"
  local matches
  matches=$(echo "$content" | grep -Pn "$pattern" 2>/dev/null || true)
  if [[ -n "$matches" ]]; then
    if [[ $PII_FOUND -eq 0 && $SECRETS_FOUND -eq 0 ]]; then
      : # header printed by caller
    fi
    PII_FOUND=1
    echo -e "  ${YELLOW}$file${NC} — $label"
    echo "$matches" | while IFS= read -r line; do
      echo "    $line"
    done
    echo ""
  fi
}

for file in $STAGED; do
  content=$(git show ":$file" 2>/dev/null || true)
  if [[ -z "$content" ]]; then
    continue
  fi

  for label in "${!PATTERNS[@]}"; do
    pattern="${PATTERNS[$label]}"
    matches=$(echo "$content" | grep -Pn "$pattern" 2>/dev/null || true)
    if [[ -n "$matches" ]]; then
      if [[ $SECRETS_FOUND -eq 0 ]]; then
        echo -e "\n${RED}Secret scan failed — possible secrets detected in staged SKILL.md files:${NC}\n"
      fi
      SECRETS_FOUND=1
      echo -e "  ${YELLOW}$file${NC} — $label"
      echo "$matches" | while IFS= read -r line; do
        echo "    $line"
      done
      echo ""
    fi
  done

  if echo "$content" | grep -q "pii-exempt"; then
    continue
  fi

  leak_header_printed=false
  for label in "${!PUBLIC_LEAK_PATTERNS[@]}"; do
    pattern="${PUBLIC_LEAK_PATTERNS[$label]}"
    matches=$(echo "$content" | grep -Pn "$pattern" 2>/dev/null || true)
    if [[ -n "$matches" ]]; then
      if [[ "$leak_header_printed" == "false" ]]; then
        echo -e "\n${RED}Public leak scan failed — content that belongs in local config:${NC}\n"
        echo -e "${BLUE}Use ~/.config/claude-skills/local.json — see references/local-config.md${NC}\n"
        leak_header_printed=true
      fi
      PII_FOUND=1
      echo -e "  ${YELLOW}$file${NC} — $label"
      echo "$matches" | while IFS= read -r line; do
        echo "    $line"
      done
      echo ""
    fi
  done

  if [[ -f "$PRIVATE_LEAK_FILE" ]]; then
    while IFS= read -r pattern || [[ -n "$pattern" ]]; do
      [[ -z "$pattern" || "$pattern" =~ ^[[:space:]]*# ]] && continue
      pattern="${pattern%%#*}"
      pattern="${pattern%"${pattern##*[![:space:]]}"}"
      [[ -z "$pattern" ]] && continue
      matches=$(echo "$content" | grep -Pn "$pattern" 2>/dev/null || true)
      if [[ -n "$matches" ]]; then
        if [[ "$leak_header_printed" == "false" ]]; then
          echo -e "\n${RED}Private leak scan failed (leak-patterns):${NC}\n"
          leak_header_printed=true
        fi
        PII_FOUND=1
        echo -e "  ${YELLOW}$file${NC} — custom pattern"
        echo "$matches" | while IFS= read -r line; do
          echo "    $line"
        done
        echo ""
      fi
    done < "$PRIVATE_LEAK_FILE"
  fi

  for label in "${!PII_PATTERNS[@]}"; do
    pattern="${PII_PATTERNS[$label]}"
    matches=$(echo "$content" | grep -Pn "$pattern" 2>/dev/null || true)
    if [[ -n "$matches" ]]; then
      if [[ $PII_FOUND -eq 0 ]]; then
        echo -e "\n${RED}PII scan failed — personal identifiers detected in staged SKILL.md files:${NC}\n"
        echo -e "${BLUE}Tip: use local.json / accounts.shell or add 'pii-exempt' for intentional personal content.${NC}\n"
      fi
      PII_FOUND=1
      echo -e "  ${YELLOW}$file${NC} — $label"
      echo "$matches" | while IFS= read -r line; do
        echo "    $line"
      done
      echo ""
    fi
  done
done

if [[ $SECRETS_FOUND -ne 0 ]] || [[ $PII_FOUND -ne 0 ]]; then
  echo -e "${RED}Commit blocked.${NC} Remove the secrets/PII above, then re-stage and try again."
  echo -e "To bypass this check (not recommended): git commit --no-verify\n"
  exit 1
fi

exit 0
