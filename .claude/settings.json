{
  "allowedTools": [
    "Bash(find ~/.claude/projects*)",
    "Bash(find ~/.claude/projects -name*)",
    "Bash(ls ~/.claude/projects*)",
    "Bash(jq * ~/.claude/projects*)",
    "Bash(cat ~/.claude/projects*)",
    "Bash(wc * ~/.claude/projects*)"
  ],
  "permissions": {
    "allow": [
      "Bash(bash ~/.claude/skills/agent-md-sync/scripts/check-pr-diff.sh*)",
      "Bash(export *)",
      "mcp__atlassian__jira_get_issue",
      "Bash(bash ~/.claude/skills/session-close/scripts/discover-repos.sh*)",
      "mcp__atlassian__jira_search",
      "mcp__atlassian__confluence_get_page",
      "mcp__atlassian__confluence_search",
      "Bash(bash -n *)",
      "Bash(bash scripts/install-system.sh --dry-run*)",
      "Bash(gh auth token --user *)",
      "Bash(gh auth switch --user *)",
      "Bash(gh auth switch --hostname * --user *)",
      "Bash(git fetch *)",
      "Bash(bash ~/.claude/skills/agent-md-sync/scripts/discover-components.sh*)",
      "Bash(bash ~/.claude/skills/agent-md-sync/scripts/check-coverage.sh*)",
      "Bash(bash ~/.claude/skills/issue-create/scripts/append-task-index.sh*)",
      "Bash(terraform fmt -check*)",
      "Bash(terraform validate*)",
      "Bash(terraform init -backend=false*)",
      "Bash(gh label list*)",
      "Bash(aws sts get-caller-identity*)",
      "mcp__atlassian__jira_get_transitions",
      "Bash(bash ~/.claude/skills/issue-create/scripts/detect-context.sh*)",
      "mcp__atlassian__jira_get_project_components",
      "Bash(bash ~/.claude/skills/session-close/scripts/check-concurrent-session.sh*)",
      "Bash(bash ai/claude/skills/agent-md-sync/scripts/discover-components.sh*)",
      "Bash(bash ai/claude/skills/agent-md-sync/scripts/check-pr-diff.sh*)",
      "Bash(git -C * branch)",
      "Bash(gh pr view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(git -C * diff*)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * fetch*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * reflog*)",
      "Bash(git -C * worktree list)",
      "Bash(git merge-base *)",
      "mcp__github__issue_read",
      "mcp__github__search_issues",
      "mcp__github__pull_request_read",
      "mcp__github__list_issues",
      "Bash(bash ~/.claude/skills/git-ops/scripts/verify-closes.sh*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/branch-guard.py" },
          { "type": "command", "command": "python3 ~/.claude/hooks/git-ops-reminder.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/git-ops-track.py" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/branch-guard-track.py" }
        ]
      }
    ]
  }
}
