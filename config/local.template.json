{
  "$schema": "ai-skills-local-v1",
  "comment": "Copy to ~/.config/ai-skills/local.json and fill in. NEVER commit the filled file. Use any labels you want in your private copy — this template stays employer-agnostic.",

  "accounts": {
    "personal": {
      "label": "Personal GitHub",
      "git_name": "",
      "git_email": "",
      "github_user": "",
      "ssh_host": "github.com-personal",
      "remote_match": ["github.com-personal", "github.com/YOUR_USER"]
    },
    "work": {
      "label": "Employer (primary job)",
      "git_name": "",
      "git_email": "",
      "github_user": "",
      "ssh_host": "github.com",
      "remote_match": ["github.com:YOUR_EMU_USER", "git.corp."],
      "github_orgs": []
    },
    "client_contract": {
      "label": "Client / contract (e.g. GitLab)",
      "git_name": "",
      "git_email": "",
      "remote_match": ["gitlab.com"],
      "gitlab_host": "gitlab.com"
    }
  },

  "jira": {
    "account": "work",
    "base_url": "",
    "project_key": "",
    "default_issue_type": "Story",
    "epic_link_field": "",
    "epic_owners_note": "Epics: managers only — do not create via AI",
    "example_ticket_key": "PROJ-12345"
  },

  "routing": {
    "personal_kb_github": "YOUR_USER/your-repo",
    "work_github_orgs": []
  },

  "notion": {
    "repositories_data_source": "collection://YOUR-NOTION-DATA-SOURCE-UUID"
  },

  "routing_cache": {
    "repo_routing_json": "~/.config/ai-skills/repo-routing.json",
    "comment": "Private cache exported from Notion — see docs/guides/repo-routing-cache.md. Never commit."
  },

  "domains": {
    "acme": {
      "label": "Acme Corp (fictional example — replace with your domain in private local.json)",
      "cursor_rules_repo": "acme-cursor-rules",
      "notes": "Template only. Real slugs live in your private copy or ~/.config/ai-skills/domains/<slug>.json — see principles/domains.md"
    }
  },

  "github_projects": {
    "work-primary": { "owner": "YOUR_USER", "number": 0 },
    "client-contract": { "owner": "YOUR_USER", "number": 0 },
    "homelab": { "owner": "YOUR_USER", "number": 0 },
    "learning": { "owner": "YOUR_USER", "number": 0 },
    "personal": { "owner": "YOUR_USER", "number": 0 },
    "mtb": { "owner": "YOUR_USER", "number": 0 },
    "iot": { "owner": "YOUR_USER", "number": 0 }
  },

  "slack": {
    "vault_support_channel": ""
  },

  "repos": {
    "work_skills": ""
  },

  "comms_write": {
    "examples_root": "",
    "memex_repo_path": "~/Projects/personal/memex",
    "examples_relative": "ai/claude/skills/comms-write-context/examples"
  },

  "candidate_pre_screen": {
    "memex_repo_path": "~/Projects/personal/memex",
    "context_root": "Raw/Resources/<your-hiring-folder>",
    "openings_glob": "Hiring-*",
    "crm_person_path": "CRM/Person",
    "handoff_gate": "Do not advance to client hiring manager until manager pre-screen completes",
    "screening_calendar_note": ""
  },

  "weekly_reports": {
    "client_contract": {
      "display_name": "Client account name for deck rows",
      "sharepoint_deck_url": "",
      "recurring_github_issue": "",
      "quote_attribution_note": "Attribute quotes by name and role",
      "deadline_note": "",
      "vault_format_ref": "Raw/Resources/<your-client-folder>/Weekly-Deck.md",
      "output_file": "Outputs/Weekly/Client-Contract-Weekly-YYYY-MM-DD.md"
    },
    "work_team": {
      "display_name": "Your name as shown on the team wiki",
      "wiki_section": "",
      "meeting_note": "",
      "vault_agent_ref": "Agents/<your-weekly-report-rules>.md",
      "output_file": "Outputs/Weekly/Work-Team-Weekly-YYYY-MM-DD.md"
    }
  }
}
