export SKILLS_PERSONAL_EMAIL=""
export SKILLS_PERSONAL_GH_HOST="github.com-personal"

# --- Work (primary employer) ---
export SKILLS_WORK_GIT_NAME=""
export SKILLS_WORK_GIT_EMAIL=""
export SKILLS_WORK_GH_USER=""
export SKILLS_WORK_ORGS=""
export SKILLS_JIRA_BASE_URL=""
export SKILLS_JIRA_PROJECT_KEY=""
export SKILLS_JIRA_EPIC_LINK_FIELD=""
export SKILLS_WORK_DOCS_REPO=""

# --- Client / contract (optional third git identity) ---
