# Shell exports for scripts (setup-account.sh, direnv helpers)
# Copy to ~/.config/ai-skills/accounts.shell — NEVER commit the filled file.
# NOT named *.env — Claude's block-env-read hook blocks .env paths.
#
# Source from ~/.zshrc:
#   [ -f ~/.config/ai-skills/accounts.shell ] && source ~/.config/ai-skills/accounts.shell

