{
  "version": 1,
  "notion_data_source": "collection://YOUR-NOTION-REPOSITORIES-DATA-SOURCE-UUID",
  "synced_from": "notion",
  "synced_at": "YYYY-MM-DD",
  "defaults": {
    "no_remote": {
      "ticket_system": "GitHub"
    }
  },
  "repos": {
    "YOUR_USER/ai-skills": {
      "ticket_system": "GitHub"
    },
    "YOUR_WORK_ORG/some-work-repo": {
      "ticket_system": "Jira"
    },
    "YOUR_USER/minecraft-modpack-example": {
      "ticket_system": "GitHub",
      "notes": "Dev and player/tester reports both route to GitHub in this repo"
    }
  }
}
